# Example BBS configuration — copy to bbs.yaml and edit before running

bbs:
  # Your station callsign (max 6 chars) and SSID (0-15)
  callsign: "N0CALL"
  ssid: 1
  # Displayed in the login banner
  name: "My Amateur Radio BBS"
  sysop: "N0CALL"
  location: "Anytown, USA"
  # Maximum concurrent connected users (0 = unlimited)
  max_users: 20
  # Idle timeout in seconds before disconnecting a user (0 = disabled)
  idle_timeout: 300
  # Write timeout in seconds: if a drain() call blocks longer than this the
  # session is torn down.  Protects against stations that vanish off the air
  # without sending a disconnect (common on AX.25 / RF links).
  write_timeout: 30
  # Path length thresholds (hop count) used to select verbosity of BBS output.
  # Hop count is detected from the SABM/SABME frame seen in AGWPE monitoring;
  # non-AX.25 transports always use SHORT (full verbosity).
  #   SHORT  — 0 to (medium_hops - 1): full banner and welcome text.
  #   MEDIUM — medium_hops to (long_hops - 1): abbreviated one-liner.
  #   LONG   — long_hops and above: minimal callsign-only output.
  path_length_medium_hops: 2   # 1+ digipeater hops → medium verbosity
  path_length_long_hops: 4    # 3+ digipeater hops → minimal verbosity

transports:
  # Enable one or more transports. The BBS listens on all enabled transports simultaneously.

  # ─── KISS transports (kiss_serial / kiss_tcp) ──────────────────────────
  # ⚠  UI-FRAMES ONLY  ⚠
  # These transports DO NOT implement AX.25 connected mode. They handle
  # UI frames only (APRS, beacons, ID broadcasts). A normal BBS client
  # that sends SABM to connect will time out — no UA reply is generated.
  #
  # For real BBS sessions over the air, use ONE of:
  #   • agwpe        — works everywhere; Direwolf has it on TCP port 8000
  #   • kernel_ax25  — Linux only; requires kissattach + axports
  #
  # Enable kiss_serial / kiss_tcp ONLY if you want APRS-style beacons or
  # heard-station logging from monitored UI traffic.
  # ────────────────────────────────────────────────────────────────────────

  # KISS over serial port (Dire Wolf /dev/ttyACM0 or hardware TNC)
  kiss_serial:
    enabled: false
    device: "/dev/ttyACM0"
    baud: 9600
    # AX.25 port number inside KISS frames (0-15)
    port: 0
    beacon_text: ""
    beacon_dest: "BEACON"   # historical KISS default was "QST"; use "ID" for Ka-Node style
    beacon_interval: 20     # minutes
    beacon_path: ""         # e.g. "WIDE1-1,WIDE2-1"

  # KISS over TCP socket (Dire Wolf default: 8001)
  kiss_tcp:
    enabled: true
    host: "127.0.0.1"
    port: 8001
    # AX.25 port number inside KISS frames (0-15)
    ax25_port: 0
    beacon_text: ""
    beacon_dest: "BEACON"   # historical KISS default was "QST"; use "ID" for Ka-Node style
    beacon_interval: 20     # minutes
    beacon_path: ""         # e.g. "WIDE1-1,WIDE2-1"

  # Linux kernel AX.25 (AF_AX25 sockets via axports / kissattach)
  kernel_ax25:
    enabled: false
    # axport name from /etc/ax25/axports
    axport: "ax0"
    beacon_text: "W6ELA-5 BBS - Palo Alto"
    beacon_interval: 20
    beacon_path: ""   # e.g. "WIDE1-1,WIDE2-1" or "KD6XYZ-3,W6ABC"

  # AGWPE / AGW Packet Engine (SV2AGW) TCP API — connects to a running AGWPE or
  # compatible engine (e.g. Direwolf with AGW interface, UZ7HO Soundmodem).
  agwpe:
    enabled: false
    host: "127.0.0.1"
    # AGWPE default TCP port is 8000
    port: 8000
    # Radio port number inside AGWPE (0-based)
    agw_port: 0
    # Leave blank if AGWPE has no password set
    password: ""
    beacon_text: ""
    beacon_dest: "BEACON"
    beacon_interval: 20   # minutes
    beacon_path: ""       # e.g. "WIDE1-1,WIDE2-1"

  # Plain TCP (for Telnet / local testing)
  tcp:
    enabled: true
    host: "0.0.0.0"
    port: 6300

database:
  # Path to SQLite database file
  path: "data/bbs.db"
  # Number of days to keep connection journal entries (0 = keep forever)
  connection_log_days: 30

auth:
  # HMAC-SHA256 challenge-response: shared secret set per-user via web interface.
  # Most features are accessible with just a callsign (which is carried in the AX.25
  # connection); HMAC auth unlocks privileged operations (post, settings change, etc.)
  # Nonce length in hex characters (must be even; 32 = 16 bytes of entropy)
  nonce_hex_length: 32
  # Failed auth attempts before lockout
  max_attempts: 3
  # Lockout duration in seconds
  lockout_seconds: 900

plugins:
  bulletins:
    enabled: true
    # When true, new users are created as pending and must be approved by
    # the sysop (via the web UI) before they can post to bulletins.
    # When false (default), all users can post immediately.
    enforce_active: false
    # Maximum message body size in bytes (keep small for 1200bps)
    max_body_bytes: 4096
    # Maximum subject length in characters
    max_subject_chars: 25
    # Default areas created on first run
    default_areas:
      - { name: "GENERAL", description: "General discussion" }
      - { name: "TECH",    description: "Technical topics" }
      - { name: "DX",      description: "DX news and reports" }

  chat:
    enabled: true
    # Lines of history kept in memory per room
    history_lines: 20
    # Default rooms created on first run
    default_rooms:
      - { name: "main", description: "Main chat room" }

  lastconn:
    enabled: true
    # Maximum rows shown in the plugin listing
    limit: 200

  info:
    enabled: true
    # Optional seed message – used only when the database row is still empty.
    # Once the sysop edits the message via the web UI this value is ignored.
    message: ""

  heard:
    enabled: true
    # Maximum rows shown in the listing
    limit: 200

  display:
    enabled: false          # Set to true after installing deps (pip install bbs2[display])
    # Framebuffer device (480x320 @ RGB565)
    fb_device: /dev/fb0
    width: 480
    height: 320
    # Seconds between screen refreshes (0.5–5 is a good range)
    refresh_interval: 1.0
    # Dim screen after N minutes of RF inactivity (0 = never dim)
    idle_dim_minutes: 5
    # Blank screen after N minutes of RF inactivity (0 = never blank)
    idle_off_minutes: 30
    # Software brightness level when dimmed (1–100 %)
    dim_level: 20
    # Optional: sysfs path to hardware backlight (leave empty for software-only dimming)
    # Example: /sys/class/backlight/soc:backlight/brightness
    backlight_path: ""
    backlight_max: 255
    # Font path: leave empty to auto-detect system fonts (prefers Terminus, falls back to DejaVu)
    # Install pixel-perfect Terminus font: sudo apt install fonts-terminus
    font_path: ""
    # Messages posted within this window are counted as "new" on the display
    bulletin_new_hours: 24
    # Length of the scrolling RF heard deque
    max_heard_scroll: 20

web:
  host: "127.0.0.1"
  port: 8080
  # Change this before first run! (used for sysop web login only)
  # The HMAC secrets for radio users are set separately per-user.
  sysop_password_hash: ""   # leave blank; set via: bbs2 --set-sysop-password
  # Secret key for Flask sessions — replace with a random string
  secret_key: "CHANGE_ME_BEFORE_RUNNING"

netrom:
  # NET/ROM node alias (up to 6 characters).  Leave blank to disable NETROM support.
  alias: ""
  # How often to broadcast the routing table as a NODES frame (minutes)
  nodes_interval: 30
  # Route expiry: a learned route is dropped if its advertiser has been silent
  # for this many minutes (default 180 = 3 hours, ~3× the default broadcast cadence)
  route_ttl_minutes: 180
  # Quality decrement applied when re-advertising a learned route (default 25)
  hop_cost: 25
  # Minimum quality required to re-advertise a route after decrement (default 10)
  min_advert_quality: 10
  # Polite-client mode (default true).  When true, NODES broadcasts contain
  # only the 7-byte header (discriminator + alias) — peers add us as a direct
  # neighbor by RX without us re-broadcasting their route tables back at them.
  # This is the convention for client/endpoint nodes on networks like NORCAL
  # 145.05.  Set to false only if you are operating as a high-reachability
  # transit NETROM node and the network admins have explicitly agreed.
  advertise_self_only: true
  # NETROM L3 crosslink classification is automatic: every incoming AX.25
  # 'C' from a callsign already in our router's adjacent-neighbor set is
  # treated as a NETROM crosslink (no BBS banner sent, wait for L3 CONNECT
  # REQ).  Unknown callers get a direct BBS session.  The neighbor set is
  # populated by NODES broadcasts received on the air and by seed_from_db
  # on startup, so in steady state every neighbor is classified correctly
  # on first contact.  Only applies on the agwpe transport for now.
  #
  # Outbound NETROM L3 info-MTU (bytes per fragment, NOT including the
  # 20-byte L3 header).  Must be ≤ (TNC PACLEN − 20) or Direwolf (or any
  # AX.25 stack honoring PACLEN) will split oversize L3 frames at L2 and
  # drop the headerless second fragment — visible as chunks missing from
  # the middle of BBS output on the user's terminal.
  #   PACLEN  recommended info_mtu
  #     256          236        (Direwolf default)
  #     128          108        (NORCAL convention, KPC-3 default)
  #      64           44        (some hardware TNCs)
  # Check your direwolf.conf for `PACLEN` and set accordingly.
  info_mtu: 108

# ─── External services (ax25d-style hosting) ──────────────────────────────────
# Route an inbound connection to an EXTERNAL PROGRAM based on the callsign-SSID
# the caller dialed — the userspace replacement for the Linux `ax25d` daemon
# (which stops working once the kernel AX.25 stack is removed).  A caller who
# connects to a mapped SSID is handed straight to the program (no BBS menu),
# with the connection wired to the program's stdin/stdout.  Requires the AGWPE
# transport for direct AX.25 callers; NET/ROM users are dispatched too (keyed
# on the L3 destination they reach us on).
#
# The program runs as the bbs service user with a MINIMAL environment (a PATH
# only — enough for a `#!/usr/bin/env python3` shebang to resolve; extend it per
# route with `env:` below).  Per-connection context is passed via argv using
# ax25d-compatible %-substitution:
#   %u/%U  caller callsign without SSID (lower/upper)
#   %s/%S  caller callsign with SSID (lower/upper)
#   %d     transport/port label       %%  literal '%'
#
# ┌───────────────────────────────────────────────────────────────────────────┐
# │ LINE ENDINGS: set `crlf: true` for any line-oriented program (most scripts, │
# │ anything using readline/fgets/input()).  AX.25 sends a bare CR, not LF, so  │
# │ without translation such a program blocks forever on its first read and     │
# │ NEVER RESPONDS (connects fine, then silence).  Leave `false` only for       │
# │ programs that speak raw AX.25 CR themselves (node, FBB, …).                  │
# └───────────────────────────────────────────────────────────────────────────┘
services:
  enabled: false                  # master switch
  # Callsigns to always refuse on a service SSID (ax25d 'L'/NOCALL idiom).
  lockout: [NOCALL, N0CALL]
  # Cap on concurrent external-program sessions (fork-bomb guard).
  max_sessions: 10
  routes:
    # Each key is a callsign-SSID that callers dial.  It must NOT be the BBS's
    # own callsign (that goes to the internal BBS).
    "N0CALL-2":
      exec: /usr/bin/xfbbd        # absolute path required
      args: ["xfbbd", "%U"]       # argv incl. argv[0]; %-substituted
      min_auth: identified        # none | identified   (OTP-gating not yet supported)
      no_digi: false              # ax25d 'D' — refuse if arrived via a digipeater
      quiet: false                # ax25d 'Q' — suppress connection logging
      crlf: true                  # translate LF <-> CR (see the box above)
      idle_timeout: 600           # reap a silent session after N seconds (0 = off)
      env:                        # optional; layered on top of the minimal PATH
        TERM: dumb
    "N0CALL-3":
      exec: /usr/sbin/node        # ax25-apps node front-end (speaks raw CR)
      args: ["node"]
      crlf: false

logging:
  level: "INFO"     # DEBUG, INFO, WARNING, ERROR
  # Optional file path; leave blank to log to stdout only
  file: ""
